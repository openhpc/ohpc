Lmod 9.5 calls stat() on the path of each of its commands to find the
directory that contains its Lua modules. Lmod 9.4.5 called posix.stat()
of luaposix, which does not follow symbolic links. stat() of
posix.sys.stat follows symbolic links, so the S_ISLNK() check is never
true and the loop does not resolve a symbolic link to the command.

/usr/bin/modulecmd is a symbolic link to the lmod command. Lmod searches
for its Lua modules relative to /usr/bin and fails with "module 'strict'
not found".

Call lstat(), which does not follow symbolic links.

Upstream report: https://github.com/TACC/Lmod/issues/872

--- a/src/addto.in.lua
+++ b/src/addto.in.lua
@@ -66,7 +66,7 @@
 local readlink = require("posix.unistd").readlink
 local stat     = require("posix.sys.stat")
 
-local my_stat  = stat.stat(arg_0)
+local my_stat  = stat.lstat(arg_0)
 while (stat.S_ISLNK(my_stat.st_mode) ~= 0) do
    local lnk = readlink(arg_0)
    if (arg_0:find("/") and (lnk:find("^/") == nil)) then
@@ -74,7 +74,7 @@
       lnk       = dir .. "/" .. lnk
    end
    arg_0   = lnk
-   my_stat = stat.stat(arg_0)
+   my_stat = stat.lstat(arg_0)
 end
 
 local ia,ja = arg_0:find(".*/")
