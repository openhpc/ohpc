FROM registry.fedoraproject.org/fedora:latest

# python3-jinja2 and python3-pyyaml let the recipe explorer site build
# (docs/install/explorer/mksite.py via mkdoc.py --manifest) run in this
# image too; see .github/workflows/explorer-pages.yml.
RUN dnf -y install codespell make ruff ShellCheck clang-tools-extra git bats \
    python3-jinja2 python3-pyyaml

# Fedora 45 retired the shfmt package, so the step below installs the
# upstream release binary. Upstream publishes no checksum file; the
# pinned hash is the checksum of the binary this step was written with.
RUN curl -sSfL -o /usr/local/bin/shfmt \
        https://github.com/mvdan/sh/releases/download/v3.14.1/shfmt_v3.14.1_linux_amd64 \
    && echo "76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf  /usr/local/bin/shfmt" | sha256sum -c \
    && chmod +x /usr/local/bin/shfmt
