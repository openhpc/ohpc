DELIM="-ohpc"
CMD_TIMEOUT="20s"
ARCH="@ARCH@"
DISTRO_FAMILY="@DISTRO_FAMILY@"
COMPILER_FAMILIES="@COMPILER_FAMILIES@"
MPI_FAMILIES="@MPI_FAMILIES@"
PYTHON_FAMILIES="@PYTHON_FAMILIES@"
BEEGFS_TEST_PATH="/mnt/beegfs"
LUSTRE_TEST_PATH="/mnt/lustre/ohpc-test"
NUM_COMPUTES=2
GCC_DEFAULT="gnu16"
export BATS_USE_MKTEMP=1
export OMPI_MCA_rmaps_base_oversubscribe=1
#
#------------------------
# Scalasca profiling options
#------------------------
#
SCAN_MPI_LAUNCHER=prun
#

#------------------------
# GLobal openblas options
#------------------------
#
export OMP_NUM_THREADS=2

#------------------------
# OpenHPC autotools
#------------------------
#
# Many configure.ac files of the test suite require autoconf 2.71, and EL9
# provides autoconf 2.69. The autotools module adds the OpenHPC autoconf 2.71
# to PATH. The test scripts run "module purge" before "./bootstrap", and
# "module purge" unloads the autotools module. Lmod keeps a PATH entry that a
# module did not add. The OpenHPC autotools therefore stay in PATH after
# "module purge".
if [ -d /opt/ohpc/pub/utils/autotools/bin ]; then
	export PATH="/opt/ohpc/pub/utils/autotools/bin:${PATH}"
fi
