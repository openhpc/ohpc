#!/bin/bash

cd "$(dirname "$0")" || exit 1

source ./LOCAL_ENV || exit 1
export BATS_JUNIT_CLASS=$TEST_DIR
source ./common/TEST_ENV || exit 1
source ./common/functions || exit 1

status=0

for i in "$@"; do
	case $i in
	-c=* | --compiler=*)
		COMPILER_FAMILIES="${i#*=}"
		shift
		;;
	-m=* | --mpi=*)
		MPI_FAMILIES="${i#*=}"
		shift
		;;
	*)
		echo "$0: Unknown option - $*"
		# unknown option
		;;
	esac
done

for compiler in $COMPILER_FAMILIES; do
	for mpi in $MPI_FAMILIES; do

		echo
		echo
		echo "-------------------------------------------------------"
		echo "Apps: HPCG tests: $compiler-$mpi"
		echo "-------------------------------------------------------"

		rm -f HPCG*.yaml
		rm -f hpcg*.txt
		rm -f job*out

		module purge || exit 1
		module load prun || exit 1
		# A family whose module is missing fails, and the others still run
		if ! module load "$compiler" || ! module load "$mpi"; then
			echo "Apps: HPCG tests: $compiler-$mpi: module not available, family FAILED"
			status=1
			continue
		fi

		export BATS_REPORT_FILENAME=build.log.xml
		./build || status=1
		export BATS_REPORT_FILENAME=rm_execution_single_host.log.xml
		./rm_execution_single_host || status=1
		export BATS_REPORT_FILENAME=rm_execution_multi_host.log.xml
		./rm_execution_multi_host || status=1

		# save .log files for potential integration with CI
		save_logs_mpi_family . "$compiler" "$mpi"
		mv HPCG*.yaml "family-$compiler-$mpi"
		mv hpcg*.txt "family-$compiler-$mpi"
		mv job*out "family-$compiler-$mpi"
	done
done

if [ -r log.HPCG ]; then
	echo
	echo
	echo "-------------------------------------------------------"
	echo "Apps: HPCG tests: Results Summary"
	echo "-------------------------------------------------------"
	printf "%-24s %-10s %-10s %16s %16s\n" \
		Run_ID Compiler MPI_Stack Ref_GFLOP/s Curr_GFLOP/s
	cat log.HPCG

	mkdir -p logs
	cat log.HPCG >>logs/log.HPCG
	rm log.HPCG
fi

exit ${status}
