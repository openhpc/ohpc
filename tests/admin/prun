#!/usr/bin/env -S bats --report-formatter junit --formatter tap
# -*-sh-*-

load ./common/test_helper_functions || exit 1
source ./common/functions || exit 1

if [ -s ./common/TEST_ENV ];then
    source ./common/TEST_ENV
fi

@test "[prun] unsupported MPI family exits non-zero" {
    LMOD_FAMILY_MPI=nosuchmpi run prun /bin/true
    assert_failure
    [[ "$output" == *"Unsupported or unknown MPI family"* ]]
}

@test "[prun] mpich with an unknown resource manager exits non-zero" {
    RM=nosuchrm LMOD_FAMILY_MPI=mpich run prun /bin/true
    assert_failure
    [[ "$output" == *"Unknown resource manager"* ]]
}

@test "[prun] openmpi with an unknown resource manager exits non-zero" {
    RM=nosuchrm LMOD_FAMILY_MPI=openmpi4 run prun /bin/true
    assert_failure
    [[ "$output" == *"Unknown resource manager"* ]]
}

@test "[prun] mvapich2 with an unknown resource manager exits non-zero" {
    printf '#!/bin/sh\nexit 0\n' > "$BATS_TEST_TMPDIR/mpiexec.hydra"
    chmod +x "$BATS_TEST_TMPDIR/mpiexec.hydra"
    PATH="$BATS_TEST_TMPDIR:$PATH" RM=nosuchrm LMOD_FAMILY_MPI=mvapich2 run prun /bin/true
    assert_failure
    [[ "$output" == *"Unknown resource manager"* ]]
}

@test "[prun] impi with an unknown resource manager exits non-zero" {
    RM=nosuchrm LMOD_FAMILY_MPI=impi run prun /bin/true
    assert_failure
    [[ "$output" == *"Unknown resource manager"* ]]
}

check_prun_executable() {
    local resource_manager="$1" mpi_family="$2" launchers="$3"
    local expected_prefix="$4"
    local executable="$BATS_TEST_TMPDIR/application with spaces"

    mkdir -p "$BATS_TEST_TMPDIR/bin"
    cat > "$BATS_TEST_TMPDIR/bin/launcher" <<'EOF'
#!/bin/bash
printf '<%s>\n' "$@"
EOF
    chmod +x "$BATS_TEST_TMPDIR/bin/launcher"
    local launcher
    for launcher in srun mpiexec.hydra mpirun mpiexec flux; do
        ln -sf launcher "$BATS_TEST_TMPDIR/bin/$launcher"
    done
    printf '#!/bin/sh\nexit 0\n' > "$executable"
    chmod +x "$executable"
    touch "$BATS_TEST_TMPDIR/input.dat"
    cd "$BATS_TEST_TMPDIR"

    PATH="$BATS_TEST_TMPDIR/bin:$PATH" RM="$resource_manager" \
        LMOD_FAMILY_MPI="$mpi_family" OHPC_MPI_LAUNCHERS="$launchers" \
        MPI_DIR=/mpi PBS_NODEFILE=/nodes \
        FLUX_JOB_NNODES=2 FLUX_JOB_NTASKS=4 \
        run prun "$executable" "two words" "" '*.dat' $'tab\tvalue' $'line\nbreak'
    assert_success
    local expected="$expected_prefix
<$executable>
<two>
<words>
<input.dat>
<tab>
<value>
<line>
<break>"
    [[ "$output" == *"$expected" ]] || assert_equal "$expected" "$output"
}

@test "[prun] slurm launchers preserve executable paths containing spaces" {
    check_prun_executable slurm impi '' '<--mpi=pmi2>'
    check_prun_executable slurm mpich pmix '<--mpi=pmix>'
    check_prun_executable slurm mpich '' $'<-bootstrap>\n<slurm>'
    check_prun_executable slurm mvapich2 '' $'<-bootstrap>\n<slurm>'
    local family
    for family in openmpi openmpi3 openmpi4 openmpi5; do
        local prefix='<--mpi=pmix>'
        [[ "$family" != openmpi5 ]] || prefix+=$'\n<-->'
        check_prun_executable slurm "$family" pmix "$prefix"
        prefix=''
        [[ "$family" != openmpi5 ]] || prefix='<-->'
        check_prun_executable slurm "$family" '' "$prefix"
    done
}

@test "[prun] openpbs launchers preserve executable paths containing spaces" {
    local family
    for family in impi mpich mvapich2; do
        check_prun_executable openpbs "$family" '' $'<-rmk>\n<pbs>'
    done
    for family in openmpi openmpi3 openmpi4 openmpi5; do
        local prefix=$'<-x>\n<LD_LIBRARY_PATH>\n<--prefix>\n</mpi>\n<--hostfile>\n</nodes>'
        [[ "$family" != openmpi5 ]] || prefix+=$'\n<-->'
        check_prun_executable openpbs "$family" '' "$prefix"
    done
}

@test "[prun] flux launchers preserve executable paths containing spaces" {
    local family
    for family in impi mpich mvapich2; do
        check_prun_executable flux "$family" '' $'<run>\n<-N>\n<2>\n<-n>\n<4>'
    done
    for family in openmpi openmpi3 openmpi4 openmpi5; do
        local prefix=$'<run>\n<-N>\n<2>\n<-n>\n<4>\n<-o>\n<pmi=pmix>'
        [[ "$family" != openmpi5 ]] || prefix+=$'\n<-->'
        check_prun_executable flux "$family" '' "$prefix"
    done
}

@test "[prun] starts an executable whose filename contains spaces" {
    cat > "$BATS_TEST_TMPDIR/srun" <<'LAUNCHER'
#!/bin/bash
[[ "$1" == --mpi=pmix ]] || exit 2
shift
"$@"
LAUNCHER
    chmod +x "$BATS_TEST_TMPDIR/srun"
    local executable="$BATS_TEST_TMPDIR/application with spaces"
    printf '#!/bin/sh\nprintf "application started\\n"\n' > "$executable"
    chmod +x "$executable"
    PATH="$BATS_TEST_TMPDIR:$PATH" RM=slurm LMOD_FAMILY_MPI=mpich \
        OHPC_MPI_LAUNCHERS=pmix run prun "$executable"
    assert_success
    [[ "${lines[-1]}" == 'application started' ]]
}

@test "[prun] starts the checked executable rather than a glob match" {
    cat > "$BATS_TEST_TMPDIR/srun" <<'LAUNCHER'
#!/bin/bash
[[ "$1" == --mpi=pmix ]] || exit 2
shift
"$@"
LAUNCHER
    chmod +x "$BATS_TEST_TMPDIR/srun"
    local checked_dir="$BATS_TEST_TMPDIR/build[debug]"
    local other_dir="$BATS_TEST_TMPDIR/buildd"
    mkdir -p "$checked_dir" "$other_dir"
    printf '#!/bin/sh\nprintf "checked application started\\n"\n' > "$checked_dir/application"
    printf '#!/bin/sh\nprintf "other application started\\n"\n' > "$other_dir/application"
    chmod +x "$checked_dir/application" "$other_dir/application"
    PATH="$BATS_TEST_TMPDIR:$PATH" RM=slurm LMOD_FAMILY_MPI=mpich \
        OHPC_MPI_LAUNCHERS=pmix run prun "$checked_dir/application"
    assert_success
    [[ "${lines[-1]}" == 'checked application started' ]]
}
