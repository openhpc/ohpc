@test "[libs/SuperLU_DIST] multi-grid (${RESOURCE_MANAGER}/${LMOD_FAMILY_COMPILER}/${LMOD_FAMILY_MPI})" {
	if [ -n "${SIMPLE_CI}" ]; then
		skip "The multi-grid test is too heavy for SIMPLE_CI environments, like Github Actions and Cirrus CI"
	fi

	if [ ! -s pddrive4 ]; then
		flunk "pddrive4 binary does not exist"
	fi

	run_mpi_binary -t 5 ./pddrive4 "g20.rua" "${NODES}" 10
	assert_success
}
