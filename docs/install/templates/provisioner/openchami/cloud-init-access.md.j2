Finally, give root on the head node a privileged source port toward haproxy, so
`ochami cloud-init` commands keep working when run as root, and keep other
users off the OpenCHAMI container networks, which would bypass haproxy. Root's
connections to ports 8081 and 8443 on the head node's addresses leave from
`${sms_ip}` with a source port between 600 and 1023; they don't work as another
user, or through `127.0.0.1`. A unit of its own loads the rules at boot, rather
than `nftables.service`, since stopping or reloading that service flushes the
whole ruleset, podman's rules included. Root on the compute nodes gets its
privileged source port from the rules in the compute image (see [Building the
Base OS Image](#building-the-base-os-image)).

<!-- ohpc_begin -->
<!-- ohpc_comment Head node source-port rules for cloud-init -->
```bash
# Find the OpenCHAMI container networks
podman_nets=$(podman network inspect \
	--format '{%raw%}{{range .Subnets}}{{.Subnet}} {{end}}{%endraw%}' \
	$(podman network ls --format '{%raw%}{{.Name}}{%endraw%}' | grep '^openchami-') \
	| tr ' ' '\n' | grep '^[0-9.]*/[0-9]*$' | paste -sd, -)
if [[ -z "${podman_nets}" ]]; then
	echo "ERROR: no OpenCHAMI podman network subnets found" >&2
	exit 1
fi
# Give root a privileged source port toward haproxy; keep others off the networks
cat > /etc/nftables/ohpc-sport.nft <<EOF
table inet ohpc_sport
delete table inet ohpc_sport
table inet ohpc_sport {
	chain output {
		type filter hook output priority mangle; policy accept;
		ip daddr { ${sms_head_addrs} } tcp dport { 8081, 8443 } meta skuid 0 \\
			meta mark set 0x421
		ip daddr { ${podman_nets} } meta skuid != 0 \\
			reject with icmpx admin-prohibited
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		meta mark 0x421 meta l4proto tcp snat ip to ${sms_ip}:600-1023
	}
}
EOF
# Load the rules at boot
cat > /etc/systemd/system/ohpc-sport.service <<EOF
[Unit]
Description=OpenHPC source-port rules for cloud-init
After=nftables.service
Before=network-pre.target haproxy.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/ohpc-sport.nft
ExecStop=/usr/sbin/nft delete table inet ohpc_sport

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now ohpc-sport.service
```
<!-- ohpc_end -->
